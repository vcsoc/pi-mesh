{
  "name": "pi-mesh",
  "version": "2.7.4",
  "private": true,
  "type": "module",
  "description": "Native Pi Mesh coordination, dashboard and explicitly approved local workflows",
  "repository": { "type": "git", "url": "https://github.com/vcsoc/pi-mesh.git" },
  "homepage": "https://github.com/vcsoc/pi-mesh",
  "keywords": ["pi-package", "pi", "mesh"],
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./index.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:browser": "node test/workbench-browser.mjs && node test/management-browser.mjs",
    "test:queue:tui": "python3 test/input-queue-tui-smoke.py",
    "check": "node --check broker.mjs && node --check dashboard.js && node --check help.js && node --check runner.mjs && node --check fleet-panel.js && node --check management-workbench.js && npm test"
  }
}
