{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string" },
    "displayName": { "type": "string" },
    "role": { "type": "string" },
    "provider": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "thinking": { "type": ["string", "null"], "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max", null] },
    "tools": { "type": ["array", "null"], "items": { "type": "string" } },
    "sessionDir": { "type": ["string", "null"] },
    "requiredFor": { "type": "array", "items": { "type": "string" } },
    "handoffInputs": { "type": "array", "items": { "type": "string" } },
    "handoffOutputs": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["id", "displayName", "role", "provider", "model", "requiredFor", "handoffInputs", "handoffOutputs"]
}
